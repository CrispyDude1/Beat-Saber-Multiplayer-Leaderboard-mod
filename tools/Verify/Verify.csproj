<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>MultiplayerLeaderboard.Verify</AssemblyName>
    <RootNamespace>MultiplayerLeaderboard.Verify</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- A normal clone has no game Libs folder, so the verifier restores Cecil from NuGet.
         Builds on this machine can reuse the package cache. -->
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
  </ItemGroup>

</Project>
